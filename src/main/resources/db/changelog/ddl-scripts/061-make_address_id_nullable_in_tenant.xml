<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Remove unique constraint on ADDRESS_ID if it exists -->
    <changeSet id="061-remove_uk_tenant_address_id" author="plubowicz">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">SELECT COUNT(*) FROM information_schema.table_constraints WHERE lower(constraint_name)='uk_tenant_1' AND lower(table_name)='tenant' AND constraint_type='UNIQUE' AND lower(table_schema)='public'</sqlCheck>
        </preConditions>
        <dropUniqueConstraint constraintName="UK_TENANT_1" tableName="TENANT" schemaName="public"/>
    </changeSet>

    <!-- Drop the index if it still exists -->
    <changeSet id="061-drop_index_uk_tenant_1" author="plubowicz">
        <preConditions onFail="MARK_RAN">
            <!-- no-op: we'll run DROP INDEX IF EXISTS via SQL which is safe -->
        </preConditions>
        <sql splitStatements="true" stripComments="true">
            DROP INDEX IF EXISTS public.uk_tenant_1;
        </sql>
    </changeSet>

    <!-- Make ADDRESS_ID nullable -->
    <changeSet id="061-make_address_id_nullable" author="plubowicz">
        <dropNotNullConstraint tableName="TENANT" columnName="ADDRESS_ID" columnDataType="bigint"/>
    </changeSet>

</databaseChangeLog>

