<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="plubowicz" id="055-add_distribute_readings_to_meter">
        <addColumn tableName="METER">
            <column name="DISTRIBUTE_READINGS" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="plubowicz" id="055-add_comments_to_distribute_readings">
        <setColumnRemarks tableName="METER" columnName="DISTRIBUTE_READINGS" remarks="Czy odczyty licznika mają być rozdzielane na kawalerki" />
    </changeSet>

</databaseChangeLog>

