<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="050-add_lease_agreement_columns_to_settlement" author="rentowne">
        <addColumn tableName="SETTLEMENT">
            <column name="COMPENSATION_AMOUNT" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="RENT_AMOUNT" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="INTERNET_FEE" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="GAS_DEPOSIT" type="DECIMAL(19,2)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
