<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="plubowicz" id="046-add-apartment-settled-to-meter-reading">
        <addColumn tableName="METER_READING">
            <column name="APARTMENT_SETTLED" type="boolean"/>
        </addColumn>

        <update tableName="METER_READING">
            <column name="APARTMENT_SETTLED" valueBoolean="false"/>
        </update>

        <sql>ALTER TABLE METER_READING ALTER COLUMN APARTMENT_SETTLED SET NOT NULL</sql>
    </changeSet>

    <changeSet author="plubowicz" id="046-add-comment-apartment-settled">
        <setColumnRemarks tableName="METER_READING" columnName="APARTMENT_SETTLED" remarks="Czy rozliczono mieszkanie dla odczytu"/>
    </changeSet>

</databaseChangeLog>
